{
  "schemaVersion": 1,
  "id": "posteffectcontrol",
  "version": "${version}",
  "name": "PostEffectControl",
  "description": "Per-player post-processing effects (freeze, blur, glitch, effects from resource packs) pushed by the PostEffectControlPlugin server plugin.",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.dvmn2.posteffectcontrol.client.PostEffectControlClient"
    ],
    "main": [
      "net.dvmn2.posteffectcontrol.PostEffectControl"
    ]
  },
  "mixins": [
    {
      "config": "posteffectcontrol.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
